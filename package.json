{
  "name": "astrea-suite-electoral",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "build:api": "esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/api/index.js",
    "start": "node build/server.mjs",
    "deploy": "vercel --prod",
    "preview:local": "vercel dev",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-astrea --config firebase.emulator.json --only firestore \"node --import tsx --test tests/firestore.rules.test.ts\"",
    "check:api-runtime": "tsc api/index.ts --outDir build/runtime-check --module nodenext --target es2022 --resolveJsonModule --esModuleInterop --skipLibCheck && node build/runtime-check/api/index.js",
    "check": "npm run lint && npm test && npm run check:api-runtime && npm run build",
    "build:android": "npm run build:frontend && npx cap sync android && node scripts/setup-android.mjs",
    "android:open": "npx cap open android",
    "android:apk": "npm run build:android && cd android && gradlew.bat assembleDebug",
    "android:release": "powershell -ExecutionPolicy Bypass -File scripts/android-apk.ps1 -Variant Release",
    "android:aab": "powershell -ExecutionPolicy Bypass -File scripts/android-apk.ps1 -Variant Release -Bundle",
    "android:init": "npx cap add android && node scripts/setup-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
